<div class="gr">
  <section class="nlist">
    <div class="wrap">
      <div class="nlist__head">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="ped" {{ block.shopify_attributes }}>
          <div class="ped__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
          <div class="ped__b">
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Grace numbered list",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The four pillars" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a Grace bat is made." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Process" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Organised steps, led by research into what the best players actually need." }
      ]
    }
  ],
  "presets": [{ "name": "Grace numbered list", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
