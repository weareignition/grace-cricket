{%- liquid
  assign heading = section.settings.heading | default: collection.title
-%}
<div class="gr">
  <section class="phero phero--tight">
    <div class="wrap">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1>{{ heading | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="phero__rte">{{ collection.description }}</div>
      {%- elsif section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </section>

  <section class="sec sec--flush">
    <div class="wrap">
      {%- paginate collection.products by section.settings.per_page -%}
        {%- if collection.products.size > 0 -%}
          <div class="bats">
            {%- for item in collection.products -%}
              {%- render 'grace-product-card', card_product: item, index: forloop.index0, view_label: section.settings.view_label -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="empty">{{ section.settings.empty_text | escape }}</p>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="pager" aria-label="Pagination">
            {%- if paginate.previous -%}<a class="btn btn--ghost" href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
            <span class="pager__count">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a class="btn btn--ghost" href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Grace collection",
  "settings": [
    { "type": "paragraph", "content": "Shows the collection's products as Grace bat cards, in the collection's sort order." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the collection title." },
    { "type": "checkbox", "id": "show_description", "label": "Use the collection description", "default": true, "info": "Falls back to the text below when the collection has no description." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A modern players' range. Hand-built English willow, tuned to put more energy into the ball. No grades, figures up front." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 3, "max": 24, "step": 3, "default": 12 },
    { "type": "text", "id": "view_label", "label": "Card link label", "default": "View" },
    { "type": "text", "id": "empty_text", "label": "Empty collection message", "default": "No bats here yet." }
  ],
  "presets": [{ "name": "Grace collection" }],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
