{%- if section.settings.text != blank -%}
  <div class="gr">
    <div class="topbar">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        {{ section.settings.text | escape }}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Grace announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Direct from the maker · Built for the next ball" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ]
}
{% endschema %}
