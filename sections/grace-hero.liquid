{%- liquid
  assign has_media = false
  if section.settings.video != blank or section.settings.poster != blank
    assign has_media = true
  endif
-%}
<div class="gr">
  <section class="hero">
    {%- if has_media -%}
      <div class="hero__media">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1920x' }}
        {%- else -%}
          {{ section.settings.poster | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
        {%- endif -%}
      </div>
      <div class="hero__scrim"></div>
    {%- else -%}
      <div class="hero__grid"></div>
    {%- endif -%}

    {%- if section.settings.bat_image != blank -%}
      {{ section.settings.bat_image | image_url: width: 1200 | image_tag: class: 'hero__bat', loading: 'eager', alt: '' }}
    {%- elsif has_media == false -%}
      {%- render 'grace-bat', fill: '#ffffff', class: 'hero__bat' -%}
    {%- endif -%}

    <div class="hero__in">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.show_scroll -%}<div class="hero__scroll" aria-hidden="true">Scroll</div>{%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Grace hero",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "video", "id": "video", "label": "Looping film", "info": "Muted, autoplaying and looping. Keep it calm and dark enough for white type." },
    { "type": "image_picker", "id": "poster", "label": "Banner image", "info": "Shown when no film is set. With neither, the blue gradient is used." },
    { "type": "image_picker", "id": "bat_image", "label": "Bat image (optional)", "info": "A cut-out bat on a transparent background, placed on the right." },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Grace Cricket · New Zealand" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold text is set heavier.", "default": "Win the <strong>next ball.</strong>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Modern players' bats, built by the maker the country's best trust. Direct from Pete's hands to yours." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the bats" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Find your fit" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "checkbox", "id": "show_scroll", "label": "Show scroll cue", "default": true }
  ],
  "presets": [{ "name": "Grace hero" }]
}
{% endschema %}
