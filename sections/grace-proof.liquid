<div class="gr">
  <section class="proof{% if section.settings.background == 'mist' %} proof--mist{% endif %}{% if section.settings.layout == 'wall' %} proof--wall{% endif %}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="wrap">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      {%- liquid
        assign rows = 1
        if section.settings.layout == 'wall'
          assign rows = 2
        endif
      -%}
      {%- for row in (1..rows) -%}
        {%- liquid
          assign row_blocks = section.blocks
          if row == 2
            assign row_blocks = section.blocks | reverse
          endif
        -%}
        <div class="marquee">
          <div class="marquee__track{% if row == 2 %} marquee__track--rev{% endif %}" style="animation-duration: {{ section.settings.speed }}s">
            {%- comment -%} Each track is output twice so the loop is seamless; copies are hidden from assistive tech. {%- endcomment -%}
            {%- for pass in (1..2) -%}
              {%- for block in row_blocks -%}
                {%- assign tone = forloop.index0 | modulo: 6 | plus: 1 -%}
                <div class="pplayer pplayer--{{ tone }}"{% if pass == 1 and row == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 480, 600', sizes: '240px', alt: block.settings.image.alt }}
                  {%- endif -%}
                  {%- if block.settings.caption != blank -%}<span class="cap">◈ {{ block.settings.caption | escape }}</span>{%- endif -%}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Grace player carousel",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the game" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chosen by more of the country's best than any other." },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "paper", "label": "White" }, { "value": "mist", "label": "Mist" }], "default": "paper" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "row", "label": "Single row" }, { "value": "wall", "label": "Wall (two rows, opposite directions)" }], "default": "row" },
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 50 },
    { "type": "paragraph", "content": "Caption players by level, not by name, and only use images the client has cleared. Do not present a player as using a Grace bat." }
  ],
  "blocks": [
    {
      "type": "player",
      "name": "Player",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "International" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grace player carousel",
      "blocks": [
        { "type": "player", "settings": { "caption": "International" } },
        { "type": "player", "settings": { "caption": "Blackcap" } },
        { "type": "player", "settings": { "caption": "First-class" } },
        { "type": "player", "settings": { "caption": "International" } },
        { "type": "player", "settings": { "caption": "Domestic" } },
        { "type": "player", "settings": { "caption": "Blackcap" } },
        { "type": "player", "settings": { "caption": "First-class" } },
        { "type": "player", "settings": { "caption": "International" } }
      ]
    }
  ]
}
{% endschema %}
