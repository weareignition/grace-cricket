<div class="gr">
  <section class="edit2{% if section.settings.image_side == 'left' %} edit2--flip{% endif %}">
    <div class="wrap">
      <div class="edit2__grid">
        <div class="edit2__txt">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
          {{ section.settings.text }}
        </div>
        <div class="edit2__img">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 1000, 1400', sizes: '(min-width: 900px) 45vw, 100vw', alt: section.settings.image.alt }}
          {%- endif -%}
          {%- if section.settings.caption != blank -%}<span class="cap">{{ section.settings.caption | escape }}</span>{%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Grace editorial",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The best set the standard." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>For years, the country's top players have trusted Pete's eye and his hands.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    { "type": "select", "id": "image_side", "label": "Image side", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right" }
  ],
  "presets": [{ "name": "Grace editorial" }]
}
{% endschema %}
