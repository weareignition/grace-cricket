{%- assign heading = section.settings.heading | default: page.title -%}
<div class="gr">
  <section class="phero{% if section.settings.tight %} phero--tight{% endif %}">
    <div class="wrap">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1>{{ heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="phero__cta"><a class="btn btn--solid" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Grace page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "tight", "label": "Less space below", "default": false }
  ],
  "presets": [{ "name": "Grace page hero" }]
}
{% endschema %}
