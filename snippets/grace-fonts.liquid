{%- comment -%} Self-hosted Grace typefaces (SIL Open Font Licence): Archivo, Inter, IBM Plex Mono. {%- endcomment -%}
{% comment %}theme-check-disable AssetPreload{% endcomment %}
<link rel="preload" as="font" href="{{ 'grace-archivo.woff2' | asset_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ 'grace-inter.woff2' | asset_url }}" type="font/woff2" crossorigin>
{% comment %}theme-check-enable AssetPreload{% endcomment %}
<style>
  @font-face { font-family: 'Archivo'; font-style: normal; font-weight: 100 900; font-display: swap; src: url('{{ 'grace-archivo.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'Inter'; font-style: normal; font-weight: 100 900; font-display: swap; src: url('{{ 'grace-inter.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'IBM Plex Mono'; font-style: normal; font-weight: 400; font-display: swap; src: url('{{ 'grace-plex-mono-400.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'IBM Plex Mono'; font-style: normal; font-weight: 500; font-display: swap; src: url('{{ 'grace-plex-mono-500.woff2' | asset_url }}') format('woff2'); }
</style>
